# web3/chains: EVM networks ready to use (import "github.com/cajulang/web3/chains").
#
#   c := chains.base                         # a *chains.Chain
#   c.id                                     # 8453
#   c.rpc_urls[0]                            # "https://mainnet.base.org"
#   c.explorer_tx("0x...")                   # "https://basescan.org/tx/0x..."
#   chains.by_id(42161).name                 # "Arbitrum One"
#   my := chains.define_chain(1337, "Local", "ETH", "http://127.0.0.1:8545")
#
# rpc_urls are public endpoints that need no key (checked in November 2026); they are rate
# limited, so production apps should put their own provider's URL first (ClientConfig.url or urls
# in web3/rpc; by default a client uses all of rpc_urls, falling back from one to the next). Addresses are EIP-55; "" means the contract is not deployed there (or not known).
import "std/strings"

# the coin a chain pays gas with
export struct Currency {
  name: str
  symbol: str
  decimals: int
}

# an EVM network
export struct Chain {
  id: int                       # the chain id (EIP-155)
  name: str                     # "Ethereum", "Base Sepolia"...
  network: str                  # a slug: "ethereum", "base-sepolia"...
  native_currency: Currency
  rpc_urls: []str               # public, keyless, https (the first is the default)
  explorer_url: str             # "https://etherscan.io" (no trailing slash)
  explorer_api: str             # an Etherscan-style API endpoint
  testnet: bool
  multicall3: str               # Multicall3, where deployed
  ens_registry: str             # ENS registry (Ethereum and Sepolia)
  ens_universal_resolver: str   # ENS UniversalResolver (Ethereum and Sepolia)
  entry_point_v07: str          # ERC-4337 EntryPoint v0.7
  block_time_ms: int            # about how often a block comes (0: unknown; measured in November 2026)
}

export const MULTICALL3 = "0xcA11bde05977b3631167028862bE2a173976CA11"
export const ENS_REGISTRY = "0x00000000000C2E074eC69A0dFb2997BA6C7d2e1e"
export const ENS_UNIVERSAL_RESOLVER = "0xeEeEEEeE14D718C2B47D9923Deab1335E144EeEe"
export const ENTRY_POINT_V07 = "0x0000000071727De22E5E9d8BAf0edAc6f37da032"

fn eth() -> Currency { return Currency{name: "Ether", symbol: "ETH", decimals: 18} }

# Etherscan's API (V2: one endpoint for every chain it covers, chosen by chainid)
fn etherscan_api(id: int) -> str { return "https://api.etherscan.io/v2/api?chainid=" + str(id) }

# a chain with the contracts deployed at their usual addresses (Multicall3, EntryPoint v0.7)
fn known(id: int, name: str, network: str, cur: Currency, urls: []str, explorer: str, testnet: bool, block_ms: int) -> *Chain {
  return &Chain{id: id, name: name, network: network, native_currency: cur, rpc_urls: urls, explorer_url: explorer, explorer_api: etherscan_api(id), testnet: testnet, multicall3: MULTICALL3, entry_point_v07: ENTRY_POINT_V07, block_time_ms: block_ms}
}

fn with_ens(c: *Chain) -> *Chain {
  c.ens_registry = ENS_REGISTRY
  c.ens_universal_resolver = ENS_UNIVERSAL_RESOLVER
  return c
}

# ---------------------------------------------------------------- Ethereum

export let ethereum = with_ens(known(1, "Ethereum", "ethereum", eth(), []str{"https://ethereum-rpc.publicnode.com", "https://eth.drpc.org", "https://cloudflare-eth.com"}, "https://etherscan.io", false, 12000))
export let sepolia = with_ens(known(11155111, "Sepolia", "sepolia", Currency{name: "Sepolia Ether", symbol: "ETH", decimals: 18}, []str{"https://ethereum-sepolia-rpc.publicnode.com", "https://rpc.sepolia.ethpandaops.io"}, "https://sepolia.etherscan.io", true, 12000))
# Holesky was retired in 2025 (Hoodi replaces it); its public RPCs may no longer answer
export let holesky = known(17000, "Holesky", "holesky", Currency{name: "Holesky Ether", symbol: "ETH", decimals: 18}, []str{"https://ethereum-holesky-rpc.publicnode.com"}, "https://holesky.etherscan.io", true, 12000)
export let hoodi = known(560048, "Hoodi", "hoodi", Currency{name: "Hoodi Ether", symbol: "ETH", decimals: 18}, []str{"https://ethereum-hoodi-rpc.publicnode.com"}, "https://hoodi.etherscan.io", true, 12000)

