# ---------------------------------------------------------------- lookups

# every chain above
export fn all() -> []*Chain {
  return []*Chain{ethereum, sepolia, holesky, hoodi, base, base_sepolia, arbitrum, arbitrum_sepolia, optimism, optimism_sepolia, polygon, polygon_amoy, bsc, bsc_testnet, avalanche, avalanche_fuji, gnosis, linea, scroll, zksync}
}

# the chain with this id, or nil
export fn by_id(id: int) -> *Chain {
  for _, c := range all() { if c.id == id { return c } }
  return nil
}

# any other EVM chain: its id, name, the symbol of its coin (18 decimals) and an RPC URL. No
# explorer and no known contracts; fill the fields that apply
export fn define_chain(id: int, name: str, symbol: str, rpc_url: str) -> *Chain {
  urls := []str{}
  if rpc_url != "" { urls = append(urls, rpc_url) }
  return &Chain{id: id, name: name, network: slug(name), native_currency: Currency{name: symbol, symbol: symbol, decimals: 18}, rpc_urls: urls}
}

# "BNB Smart Chain" -> "bnb-smart-chain"
fn slug(name: str) -> str {
  out := []byte{}
  dash := false
  for i := 0; i < len(name); i++ {
    ch := int(name[i])
    if ch >= 65 && ch <= 90 { ch = ch + 32 }
    if (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) {
      if dash && len(out) > 0 { out = append(out, byte(45)) }
      dash = false
      out = append(out, byte(ch))
    } else {
      dash = true
    }
  }
  return string(out)
}

# the explorer page of a transaction ("" without an explorer)
export fn (c: *Chain) explorer_tx(hash: str) -> str {
  if c.explorer_url == "" { return "" }
  return strings.trim_suffix(c.explorer_url, "/") + "/tx/" + hash
}

# the explorer page of an address ("" without an explorer)
export fn (c: *Chain) explorer_address(addr: str) -> str {
  if c.explorer_url == "" { return "" }
  return strings.trim_suffix(c.explorer_url, "/") + "/address/" + addr
}

# the explorer page of a block ("" without an explorer)
export fn (c: *Chain) explorer_block(number: int) -> str {
  if c.explorer_url == "" { return "" }
  return strings.trim_suffix(c.explorer_url, "/") + "/block/" + str(number)
}
